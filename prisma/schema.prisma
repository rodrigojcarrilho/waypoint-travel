generator client {
  provider = "prisma-client-js"
}

// Use sqlite for zero-setup local dev. Switch provider to "postgresql" for Supabase.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum ItineraryItemType {
  ACTIVITY
  MEAL
  TRANSFER
  OTHER
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
  UNKNOWN
}

enum NotificationType {
  TRIP_UPDATE
  MEMBER_JOINED
  EXPENSE_ADDED
  INVITE
  SYSTEM
}

enum ExpenseSplitType {
  PERSONAL
  SHARED
}

enum ExpenseSplitMode {
  EQUAL
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   TripMember[]
}

model Guest {
  id           String   @id @default(cuid())
  displayName  String
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      TripMember[]
}

model Trip {
  id           String   @id @default(cuid())
  name         String
  description  String?
  origin       String?
  destination  String?
  destinations String?
  startDate    DateTime
  endDate      DateTime
  coverColor   String   @default("#0d9488")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members         TripMember[]
  invites         TripInvite[]
  itineraryItems  ItineraryItem[]
  flights         Flight[]
  accommodations  Accommodation[]
  transfers       Transfer[]
  carRentals      CarRental[]
  expenses        Expense[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  presence        PresenceSession[]
}

model TripMember {
  id        String     @id @default(cuid())
  tripId    String
  role      MemberRole @default(EDITOR)
  userId    String?
  guestId   String?
  joinedAt  DateTime   @default(now())

  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  guest         Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)
  paidExpenses  Expense[]       @relation("PaidBy")
  expenseSplits ExpenseSplit[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  presence      PresenceSession[]

  @@unique([tripId, userId])
  @@unique([tripId, guestId])
}

model TripInvite {
  id        String     @id @default(cuid())
  tripId    String
  token     String     @unique
  role      MemberRole @default(EDITOR)
  label     String?
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int        @default(0)
  createdAt DateTime   @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ItineraryItem {
  id          String            @id @default(cuid())
  tripId      String
  dayDate     DateTime
  title       String
  description String?
  type        ItineraryItemType @default(ACTIVITY)
  startTime   String?
  endTime     String?
  location    String?
  latitude    Float?
  longitude   Float?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Flight {
  id                 String       @id @default(cuid())
  tripId             String
  airline            String?
  flightNumber       String
  departureAirport   String
  arrivalAirport     String
  departureTime      DateTime
  arrivalTime        DateTime
  status             FlightStatus @default(SCHEDULED)
  confirmationCode   String?
  seatInfo           String?
  notes              String?
  costAmount         Float?
  costCurrency       String?
  // Extensible fields for future API integration
  externalProvider   String?
  externalFlightId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Accommodation {
  id            String   @id @default(cuid())
  tripId        String
  name          String
  address       String?
  checkIn       DateTime
  checkOut      DateTime
  bookingRef    String?
  latitude      Float?
  longitude     Float?
  notes         String?
  url           String?
  costAmount    Float?
  costCurrency  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Transfer {
  id          String   @id @default(cuid())
  tripId      String
  title       String
  fromLocation String
  toLocation  String
  datetime    DateTime
  transportType String?
  bookingRef  String?
  notes       String?
  costAmount  Float?
  costCurrency String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model CarRental {
  id              String   @id @default(cuid())
  tripId          String
  company         String
  pickupLocation  String
  dropoffLocation String?
  pickupAt        DateTime
  returnAt        DateTime
  bookingRef      String?
  notes           String?
  costAmount      Float?
  costCurrency    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Expense {
  id                    String            @id @default(cuid())
  tripId                String
  title                 String
  amount                Float
  currency              String            @default("USD")
  paidById              String
  expenseDate           DateTime          @default(now())
  notes                 String?
  splitType             ExpenseSplitType  @default(SHARED)
  splitMode             ExpenseSplitMode  @default(EQUAL)
  linkedAccommodationId String?           @unique
  linkedFlightId        String?           @unique
  linkedTransferId      String?           @unique
  linkedCarRentalId     String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy   TripMember     @relation("PaidBy", fields: [paidById], references: [id])
  splits   ExpenseSplit[]
}

model ExpenseSplit {
  id       String @id @default(cuid())
  expenseId String
  memberId String
  amount   Float

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
}

model Notification {
  id        String           @id @default(cuid())
  tripId    String
  memberId  String?
  type      NotificationType @default(TRIP_UPDATE)
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TripMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id         String   @id @default(cuid())
  tripId     String
  memberId   String?
  entityType String
  entityId   String?
  action     String
  snapshot   String
  createdAt  DateTime @default(now())

  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TripMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model PresenceSession {
  id             String   @id @default(cuid())
  tripId         String
  memberId       String
  currentSection String?
  lastSeenAt     DateTime @default(now())

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripId, memberId])
}
